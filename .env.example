# ─── Querion ────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env`.

# Supabase — transaction-mode pooler (IPv4). Used by the running app.
DATABASE_URL="postgresql://postgres.hacqbbwaeacufrewpnxr:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase — session-mode pooler. Used by migrations / introspection.
DIRECT_URL="postgresql://postgres.hacqbbwaeacufrewpnxr:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# Optional — only if you run `prisma migrate dev` against this database.
# SHADOW_DATABASE_URL="postgresql://…"

# Secret used to sign the browser session cookie. Generate: openssl rand -hex 32
AUTH_SECRET="replace-me-with-a-long-random-string"

# The single password you type on the login page.
QUERION_PASSWORD="choose-a-strong-password"

# Bearer token the pi extension / CLI uses against POST /api/sync.
# Generate: openssl rand -hex 32
QUERION_SYNC_TOKEN="replace-me-with-a-long-random-string"

# Optional — redact high-confidence secrets (PEM keys, sk-…, AKIA…, ghp_…, …)
# from stored transcripts. Default true. Set "false" to store verbatim.
QUERION_REDACT_SECRETS="true"

# Optional — store only the .jsonl basename instead of the absolute path.
# Default true.
QUERION_HIDE_SOURCE_PATH="true"

# Optional — max connections in the app's pg pool (non-Vercel). Default 5.
# PRISMA_POOL_MAX="5"

# Public URL the pi extension posts to. Used by the client, not the server.
# Local dev: http://localhost:3000
QUERION_URL="http://localhost:3000"
